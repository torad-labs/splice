+export const PERMISSION_PROFILE = { codex: "dangerously-bypass-approvals-and-sandbox", claude: "dangerously-skip-permissions", scope: "isolated Docker task container; same bypass controls as historical runner" } as const;
+
+export interface InteractiveClientLaunch {
+  arm: "codex" | "splice";
+  container: string;
+  workspace: string;
+  model: string;
+  effort: string;
+  clientBase: string;
+  bearer: string;
+  prompt: string;
+  claudeSessionId: string;
+}
+
+/** Both binaries run their interactive entrypoint, inside a Docker PTY attached to the host Bun PTY. */
+export function interactiveClientArgv(input: InteractiveClientLaunch): string[] {
+  const common = ["docker", "exec", "-it", "-w", input.workspace, "-e", "TERM=xterm-256color"];
+  if (input.arm === "codex") return [
+    ...common, "-e", "CODEX_HOME=/control/codex", input.container,
+    "/opt/clients/codex", "--no-alt-screen", "--no-daemon", "--dangerously-bypass-approvals-and-sandbox",
+    "--enable", "code_mode_host", "-m", input.model,
+    "-c", `model_reasoning_effort=${JSON.stringify(input.effort)}`,
+    "-c", 'model_reasoning_summary="detailed"', "--", input.prompt,
+  ];
+  return [
+    ...common, "-e", "CLAUDE_CONFIG_DIR=/control/claude", "-e", `ANTHROPIC_BASE_URL=${input.clientBase}`,
+    "-e", `ANTHROPIC_AUTH_TOKEN=${input.bearer}`, "-e", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
+    "-e", `CLAUDE_CODE_EFFORT_LEVEL=${input.effort}`, input.container,
+    "/opt/clients/claude", "--setting-sources", "", "--disable-slash-commands", "--dangerously-skip-permissions",
+    "--strict-mcp-config", "--mcp-config", "/control/mcp.json", "--model", input.model,
+    "--effort", input.effort, "--verbose", "--session-id", input.claudeSessionId, "--", input.prompt,
+  ];
+}
