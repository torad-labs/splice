+type Row = Record<string, any>;
+export const REQUEST_PHASE_PROFILE = "strict-session-title-auxiliary-v1";
+const object = (value: unknown): Row | null => value !== null && typeof value === "object" && !Array.isArray(value) ? value as Row : null;
+const text = (value: unknown): string => typeof value === "string" ? value : Array.isArray(value) ? value.map(text).join("\n") : text(object(value)?.text ?? "");
+
+/** Only the known native session-title shape is auxiliary. Unknown structured outputs remain task/unclassified. */
+export function isSessionTitleRequest(value: unknown): boolean {
+  const wire = object(value);
+  if (!wire) return false;
+  const body = wire.type === "response.create" ? object(wire.response) ?? wire : wire;
+  const format = object(body.text?.format);
+  const schema = object(format?.schema);
+  const properties = object(schema?.properties);
+  if (format?.name !== "structured_output" || format.type !== "json_schema" || !properties || Object.keys(properties).length !== 1 || properties.title?.type !== "string") return false;
+  return Array.isArray(body.input) && body.input.some((item: Row) => item.role === "developer" && text(item.content).trimStart().startsWith("You are naming a coding session"));
+}
