+import { closeSync, mkdirSync, openSync, writeFileSync, writeSync } from "node:fs";
+import { join } from "node:path";
+import xterm from "@xterm/headless";
+import type { InteractiveCompletion } from "./interactive-session.ts";
+
+export const INTERACTIVE_MODE = "interactive-pty-v1";
+export const TERMINAL_PROFILE = { implementation: "Bun.Terminal", emulator: "@xterm/headless@5.5.0", cols: 120, rows: 40, term: "xterm-256color", exit: "ctrl-d-after-artifact; second only on exact UI confirmation" } as const;
+
+export interface InteractivePtyOptions {
+  argv: string[];
+  cwd: string;
+  receiptDir: string;
+  env?: Record<string, string | undefined>;
+  timeoutMs: number;
+  exitGraceMs?: number;
+  killGraceMs?: number;
+  /** Exact caller-vetted startup UI, never generic permission/auth acceptance. Input bytes are retained in the PTY trace. */
+  startupReplies?: Array<{ exactPrompt: string; keys: string }>;
+  completion: () => InteractiveCompletion | null | Promise<InteractiveCompletion | null>;
+}
+
+export interface InteractivePtyResult {
+  exit: number;
+  completed: boolean;
+  timedOut: boolean;
+  durationMs: number;
+  exitDurationMs: number;
+  exitMethod: "ctrl-d-after-artifact" | "ctrl-d-confirmed-after-artifact" | "none";
+  ptyClosed: boolean;
+  failure: string | null;
+  completion: InteractiveCompletion | null;
+}
+
+/** Reusable real-PTY supervisor. Completion is native persisted evidence, never ANSI scraping or quiet-time inference. */
+export async function runInteractivePty(options: InteractivePtyOptions): Promise<InteractivePtyResult> {
+  if (typeof Bun.Terminal !== "function") throw Error("This benchmark requires Bun.Terminal (Bun 1.4.3 or compatible)");
+  mkdirSync(options.receiptDir, { recursive: true, mode: 0o700 });
+  const raw = openSync(join(options.receiptDir, "terminal.raw"), "w", 0o600);
+  const trace = openSync(join(options.receiptDir, "terminal-events.jsonl"), "w", 0o600);
+  const emulator = new xterm.Terminal({ cols: TERMINAL_PROFILE.cols, rows: TERMINAL_PROFILE.rows, scrollback: 10000, allowProposedApi: true });
+  let terminal: Bun.Terminal | undefined;
+  const started = Date.now();
+  const record = (kind: string, data: Uint8Array | string) => {
+    const bytes = Buffer.from(data);
+    writeSync(trace, JSON.stringify({ kind, at_ms: Date.now(), raw_base64: bytes.toString("base64"), bytes: bytes.length }) + "\n");
+  };
+  emulator.onData(data => { if (terminal && !terminal.closed) { record("terminal_query_reply", data); terminal.write(data); } });
+  terminal = new Bun.Terminal({
+    cols: TERMINAL_PROFILE.cols, rows: TERMINAL_PROFILE.rows, name: TERMINAL_PROFILE.term,
+    data(_term, bytes) { writeSync(raw, bytes); record("pty_output", bytes); emulator.write(bytes); },
+  });
+  let proc: Bun.Subprocess | undefined;
+  let completion: InteractiveCompletion | null = null;
+  let completedAt: number | null = null;
+  let timedOut = false;
+  let failure: string | null = null;
+  let exitMethod: InteractivePtyResult["exitMethod"] = "none";
+  let exit = -1;
+  const startupReplied = new Set<number>();
+  const visibleScreen = (includeScrollback = false) => {
+    const buffer = emulator.buffer.active;
+    const start = includeScrollback ? 0 : Math.max(0, buffer.length - TERMINAL_PROFILE.rows);
+    return Array.from({ length: buffer.length - start }, (_, i) => buffer.getLine(start + i)?.translateToString(true) ?? "").join("\n");
+  };
+  try {
+    proc = Bun.spawn(options.argv, { cwd: options.cwd, env: { ...process.env, ...options.env, TERM: TERMINAL_PROFILE.term }, terminal });
+    while (proc.exitCode === null) {
+      const screen = visibleScreen();
+      if (completedAt === null) for (const [index, reply] of (options.startupReplies ?? []).entries()) {
+        if (!startupReplied.has(index) && screen.includes(reply.exactPrompt)) {
+          record("supervisor_vetted_startup_reply", reply.keys);
+          terminal.write(reply.keys);
+          startupReplied.add(index);
+        }
+      }
+      if (completedAt !== null && exitMethod === "ctrl-d-after-artifact" && screen.includes("Press Ctrl-D again to exit")) {
+        record("supervisor_confirmed_exit_key", "\x04");
+        terminal.write("\x04");
+        exitMethod = "ctrl-d-confirmed-after-artifact";
+      }
+      if (completedAt === null) {
+        completion = await options.completion();
+        if (completion) {
+          completedAt = Date.now();
+          // Let the TUI consume the same native terminal-turn event before submitting its normal empty-editor exit key.
+          await Bun.sleep(150);
+          if (proc.exitCode === null && !terminal.closed) {
+            record("supervisor_exit_key", "\x04");
+            terminal.write("\x04");
+            exitMethod = "ctrl-d-after-artifact";
+          }
+        } else if (Date.now() - started >= options.timeoutMs) {
+          timedOut = true;
+          failure = "No completed native turn artifact before timeout";
+          break;
+        }
+      } else if (Date.now() - completedAt >= (options.exitGraceMs ?? 10000)) {
+        failure = "Interactive client did not exit after native completion and Ctrl-D";
+        break;
+      }
+      await Bun.sleep(50);
+    }
+    if (proc.exitCode === null) {
+      proc.kill("SIGTERM");
+      await Promise.race([proc.exited, Bun.sleep(options.killGraceMs ?? 2000)]);
+      if (proc.exitCode === null) proc.kill("SIGKILL");
+    }
+    exit = await proc.exited;
+    if (!completion && !timedOut) {
+      completion = await options.completion();
+      if (completion) completedAt = Date.now();
+      else failure ??= "Client exited without a completed native turn artifact";
+    }
+    await new Promise<void>(resolve => emulator.write("", resolve));
+    writeFileSync(join(options.receiptDir, "terminal-screen.txt"), visibleScreen(true) + "\n", { mode: 0o600 });
+  } finally {
+    if (proc && proc.exitCode === null) { proc.kill("SIGKILL"); await proc.exited; }
+    terminal.close();
+    emulator.dispose();
+    closeSync(raw); closeSync(trace);
+  }
+  const result: InteractivePtyResult = { exit, completed: completion !== null && failure === null, timedOut, durationMs: (completedAt ?? Date.now()) - started, exitDurationMs: completedAt === null ? 0 : Date.now() - completedAt, exitMethod, ptyClosed: terminal.closed, failure, completion };
+  writeFileSync(join(options.receiptDir, "interactive-session.json"), JSON.stringify({ invocation_mode: INTERACTIVE_MODE, terminal: TERMINAL_PROFILE, ...result }, null, 2) + "\n", { mode: 0o600 });
+  return result;
+}
