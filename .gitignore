/workspace/
*.tsbuildinfo
.claude/tmp/

# gradle slot lock + holder (bun tools/gate slot)
/.gradle-slot.lock*
# A host build wrapper's per-project lock: a memory-containment wrapper around gradle may drop its
# lock at the repository root. A machine artifact, never source; the pattern matches any wrapper name.
.*-build.lock
# per-machine agent tooling installs: skills and hook mirrors
/.agents/
/.codex/
# verifier harnesses, receipts and measurements: never committed
/captures/
/.Codex/tmp/
# the downloads website, built by tools/release/downloads/website/build.ts; never committed
tools/release/downloads/site/
