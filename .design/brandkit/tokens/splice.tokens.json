  "font": {
    "lead": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Georgia",
        "serif"
      ],
      "axes": {
        "opsz": "auto",
        "SOFT": 0,
        "WONK": 0
      },
      "wordmarkAxes": {
        "opsz": 144,
        "wght": 480
      }
    },
    "name": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "data": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "type": {
    "display": {
      "family": "lead",
      "weight": 560,
      "size": "56-120px",
      "lineHeight": 0.95,
      "tracking": "-0.02em"
    },
    "heading": {
      "family": "lead",
      "weight": 580,
      "size": "32-44px",
      "lineHeight": 1.05,
      "tracking": "-0.015em"
    },
    "title": {
      "family": "name",
      "weight": 600,
      "size": "20px",
      "lineHeight": 1.3
    },
    "body": {
      "family": "name",
      "weight": 400,
      "size": "17px",
      "lineHeight": 1.5,
      "measure": "60-72ch"
    },
    "ui": {
      "family": "name",
      "weight": 500,
      "size": "14px",
      "lineHeight": "20px"
    },
    "data": {
      "family": "data",
      "weight": 500,
      "size": "13-15px",
      "lineHeight": 1.45,
      "features": "tnum"
    },
    "kicker": {
      "family": "data",
      "weight": 500,
      "size": "11-12px",
      "tracking": "0.14em",
      "case": "upper"
    }
  },
  "material": {
    "inkWidth": "3px",
    "cast": "6px",
    "radiusObject": "9px",
    "radiusInner": "7px"
  },
  "motion": {
    "hit": "90ms",
    "snap": "240ms",
    "move": "420ms",
    "easeOut": "cubic-bezier(.22,1,.36,1)",
    "easeInOut": "cubic-bezier(.65,0,.35,1)",
    "drawingsPerSecond": 12,
    "fps": 24
  },
  "space": {
    "4": "4px",
    "8": "8px",
    "12": "12px",
    "16": "16px",
    "24": "24px",
    "32": "32px",
    "48": "48px",
    "64": "64px",
    "96": "96px"
  }
}
