node_modules/
__pycache__/
*.pyc
.claude/hooks/log/

# >>> torad-managed (auto-generated; do not edit inside) >>>
.torad.state.json
.torad.lock
# <<< torad-managed <<<
.DS_Store

# generated release bundle and local validation tools
/dist/
# the console bundle is :console:bundle's output (PR 4), never committed
/console/dist/
/console/build/
/.cache/

# gradle (the build root is the repository root; the modules live where restructure plan §2.2 puts
# them, so the module build outputs are ignored at ANY depth — one rule, not one per module)
.gradle/
.kotlin/
build/
# the look tooling's committed runtime inputs are not a build output
!webui/.impeccable/build/

# agent worktrees (scratch repo copies)
.claude/worktrees/
# per-tool agent configs and release-media workspaces that live beside the repo, never in it
.agents/
.codex/
dev/media/

# #924 Phase 1: live contract receipts are per-run artifacts, not source
tools/e2e/receipts/

# secrets / credential stores (OSS-A defensive baseline)
.env
.env.*
!.env.example
auth.json
credentials.json
*.pem
*.key

# live capture output (raw request/response dumps — see .dev/release/history-rewrite-runbook.md)
**/capture/*.json
**/capture/*.log

# logs and dumps
*.log
*.dump

# --- OSS-K: internal-material untrack ignores (per-file, never blanket) ---
.claude/skills/
.claude/ledger-diffs/
.claude/agents/
.claude/workflows/
.claude/commands/
.claude/mcp.json
/torad.json
/.dev/research/924-enforcement.md
/.dev/session-review-2026-07-18.md
/.dev/research/gateway-best-practices-2026-07-18.md
/.dev/research/gateway-gaps-tracker.md
# release media projects (a node tree per release video)
/.dev/media/
# --- end OSS-K entries ---

# transient operator wall grant (/grant) — never committed
.claude/state/walls-grant.json
.claude/tmp/

# gradle slot lock + holder (bun tools/gate slot)
/.gradle-slot.lock*
# A host build wrapper's per-project lock. The gradle slot (tools/gate/src/lib/slot.ts) runs gradle through whatever
# memory-containment wrapper the box provides, when it provides one, and such a wrapper drops its
# lock beside the tree it builds — the repository root, where the build is rooted. A machine
# artifact, never source, and the pattern is the SHAPE rather than one tool's name so a box with a
# differently-named wrapper needs no edit to this file.
.*-build.lock
# per-machine agent tooling installs: skills and hook mirrors for the other seats
/.agents/
/.codex/
