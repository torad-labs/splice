        ],
        "$description": "Router provider colour. Identifies the provider; not a brand colour.",
        "source": "Splice console console.css model colours"
      },
      "local": {
        "$type": "color",
        "$value": "#7BC47F",
        "rgb": [
          123,
          196,
          127
        ],
        "$description": "Local provider colour. Identifies the provider; not a brand colour.",
        "source": "Splice console console.css model colours"
      },
      "deepseek": {
        "$type": "color",
        "$value": "#EC93C3",
