#!/usr/bin/env bash
# splice-launch — the wrapper the installed argv[0] symlinks (claudex, grok, …) exec.
# All logic lives in the daemon; this shim does the version handshake, cold-starts the daemon
# if down, POSTs /launch to get the exec recipe, and execs `env … claude …`.
# Head is inferred from argv[0] (the symlink name) or $SPLICE_HEAD.
set -euo pipefail

HEAD="${SPLICE_HEAD:-$(basename "$0")}"
[ "$HEAD" = "splice-launch" ] && HEAD="claudex"

topology_control_port() {
  local config="${SPLICE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/splice/splice.toml}"
  case "$config" in "~/"*) config="$HOME/${config#~/}" ;; esac
  [ -f "$config" ] || return 0
  awk '
    /^[[:space:]]*\[/ { in_daemon = ($0 ~ /^[[:space:]]*\[daemon\][[:space:]]*$/) }
    in_daemon && /^[[:space:]]*control_port[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, "")
      sub(/[[:space:]#].*$/, "")
      if ($0 ~ /^[0-9]+$/) { print; exit }
    }
  ' "$config"
}
# V4-177: the state root, resolved EXACTLY as StatePaths.kt resolves it — SPLICE_STATE_DIR, then
# the pre-0.4 CLAUDEX_STATE_DIR, then ~/.splice/state, adopting ~/.claude-codex/state in place when
# that is the only one on the box. Two implementations of one rule is the whole risk here: this shim
# reads the mgmt-key and config.json the daemon WRITES, so a shim that picked the other root would
# hand the operator "mgmt-key not found" on a perfectly healthy install, or cold-start a second
# daemon against an empty state dir while the real one is up. Keep the branches byte-for-byte in step
# with StatePaths.kt; StateDirAgreementTest pins them against each other.
resolve_state_dir() {
  # A variable holding only whitespace is NOT an answer. `-n` calls " " set; Kotlin's isNotBlank
  # does not, and StatePaths blank-checks PER VARIABLE. Without this, SPLICE_STATE_DIR=" " in a unit
  # file makes this read " /mgmt-key" relative to CWD and report "mgmt-key not found" on a perfectly
  # healthy install, while the daemon resolves the real root. The pattern IS isNotBlank: at least
  # one non-whitespace character. Per variable, so an empty SPLICE_STATE_DIR falls through to
  # CLAUDEX_STATE_DIR instead of skipping it.
  case "${SPLICE_STATE_DIR:-}" in *[![:space:]]*) printf '%s\n' "$SPLICE_STATE_DIR"; return 0 ;; esac
  case "${CLAUDEX_STATE_DIR:-}" in *[![:space:]]*) printf '%s\n' "$CLAUDEX_STATE_DIR"; return 0 ;; esac
  # Adoption needs POSITIVE evidence on both sides, the rule StatePaths' three-valued probe follows:
  # only proven absence may start a fresh root. `[ ! -d ]` is ALSO true for a path that cannot be
  # stat-ed, so an unreadable ~/.splice would adopt the pre-0.4 root here while the daemon declines
  # and warns. Believe "absent" only when the parent is traversable, or absent itself.
  # `-e`, not `-d`: a REGULAR FILE at the current root is not proven absence either, and `[ ! -d ]`
  # called it adoptable while StatePaths declines and reports it as a fault.
  if [ ! -e "$HOME/.splice/state" ] && { [ ! -e "$HOME/.splice" ] || [ -x "$HOME/.splice" ]; } &&
     [ -d "$HOME/.claude-codex/state" ]; then
    printf '%s\n' "$HOME/.claude-codex/state"
  else
    printf '%s\n' "$HOME/.splice/state"
  fi
}
state_control_port() {
  local config
  config="$(resolve_state_dir)/config.json"
  [ -f "$config" ] || return 0
  python3 -c 'import json, sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8")).get("controlPort")
    port = int(value)
    if 0 < port <= 65535:
        print(port)
except (OSError, ValueError, TypeError, json.JSONDecodeError):
    pass' "$config" 2>/dev/null || true
}
# Match ConfigService exactly: default < TOML < state/config.json < env aliases.
CONTROL_PORT="$(topology_control_port)"
CONTROL_PORT="${CONTROL_PORT:-3096}"
STATE_CONTROL_PORT="$(state_control_port)"
CONTROL_PORT="${STATE_CONTROL_PORT:-$CONTROL_PORT}"
CONTROL_PORT="${SPLICE_CONTROL_PORT:-${CONTROL_PROXY_PORT:-$CONTROL_PORT}}"
CONTROL="http://127.0.0.1:${CONTROL_PORT}"
JAR="${SPLICE_JAR:-${SPLICE_SHARE_DIR:-$HOME/.local/share/splice}/splice.jar}"
# Bounded heap by default (a 1000-stream fleet with unbounded per-stream buffers OOMs the JVM
# default); override with SPLICE_JVM_OPTS. Used for every daemon cold-start below.
# 1G→2G after the 2026-07-19 429 storm: ~650 concurrent SSE turns exhausted 1G even before the
# inflight cap existed; 2G rides out a full 48-inflight + 512-queue burst with headroom.
SPLICE_JVM_OPTS="${SPLICE_JVM_OPTS:--Xmx2048m -XX:+UseStringDeduplication -XX:G1PeriodicGCInterval=60000}"
STATE_DIR="$(resolve_state_dir)"
# JW-01: the spawned JVM's output lands here, never /dev/null — a boot-dead daemon must leave a
# tailable stack trace. One rolled generation at 1MB, same cap discipline as daemon.log.
LOGS_DIR="$STATE_DIR/../logs"
BOOT_LOG="$LOGS_DIR/daemon-boot.log"
KEY_FILE="${STATE_DIR}/mgmt-key"
# Safe by default: the daemon never adds --dangerously-skip-permissions unless explicitly told to.
# CLAUDEX_DANGEROUSLY_SKIP_PERMISSIONS=1 is the named opt-in here AND on the legacy Node shim —
# both paths are safe-by-default now; the old CLAUDEX_SAFE is accepted as a harmless no-op.
DANGEROUS="false"
[ "${CLAUDEX_DANGEROUSLY_SKIP_PERMISSIONS:-0}" = "1" ] && DANGEROUS="true"
# Hand-paired with splice.core.SHIM_VERSION (core/src/main/kotlin/splice/core/Versions.kt)
# — bump both together whenever this shim's behavior changes. No code generation.
SPLICE_SHIM_VERSION="shim-4"
# Hand-paired with splice.core.GATEWAY_VERSION. Release acceptance verifies the marker.
SPLICE_GATEWAY_VERSION="0.3.2"

need_jar() {
  if [ ! -f "$JAR" ]; then
    echo "splice: jar not found at $JAR (run: splice install, or set SPLICE_JAR)" >&2
    exit 1
  fi
}

# Invoked as `splice` (the admin command): pass every subcommand straight to the CLI
# (setup, status, dashboard, login <head>, install, …). The CLI self-manages the daemon.
if [ "$HEAD" = "splice" ]; then
  need_jar
  exec java -jar "$JAR" "$@"
fi

# `<command> login [--label NAME]` runs the OAuth browser flow for this head directly (no daemon
# needed); the arguments after `login` go to the CLI unchanged (v0.4.0: --label signs in another
# account of this head's kind).
if [ "${1:-}" = "login" ]; then
  need_jar
  shift
  exec java -jar "$JAR" login "$HEAD" "$@"
fi

health() { curl -sS -m 2 "${CONTROL}/health" 2>/dev/null || true; }
health_field() {
  local field="$1"
  printf '%s' "$HEALTH_JSON" | python3 -c 'import sys, json
field = sys.argv[1]
try:
    data = json.loads(sys.stdin.read() or "{}")
except Exception:
    data = {}
print(data.get(field) or "")' "$field" 2>/dev/null || true
}

# A listener is valid only when it is splice and its version matches the installed JAR/shim.
# New daemons can shut themselves down cleanly for an automatic upgrade. Legacy daemons without
# that route fail loudly instead of silently serving an incompatible API forever.
HEALTH_JSON="$(health)"
if [ -n "$HEALTH_JSON" ]; then
  RUNNING_VERSION="$(health_field version)"
  if [ -z "$RUNNING_VERSION" ]; then
    echo "splice: port $CONTROL_PORT is occupied by a non-splice or malformed health endpoint" >&2
    exit 1
  fi
  if [ "$RUNNING_VERSION" != "$SPLICE_GATEWAY_VERSION" ]; then
    KEY="$(cat "$KEY_FILE" 2>/dev/null || true)"
    if [ -z "$KEY" ]; then
      echo "splice: daemon version $RUNNING_VERSION is stale, but $KEY_FILE is unavailable; stop it and retry" >&2
      exit 1
    fi
    echo "splice: replacing stale daemon $RUNNING_VERSION with $SPLICE_GATEWAY_VERSION…" >&2
    if ! curl -fsS -m 3 -X POST "${CONTROL}/api/daemon/shutdown" \
      -H "Authorization: Bearer ${KEY}" >/dev/null; then
      echo "splice: stale daemon cannot self-stop; terminate it once, then retry" >&2
      exit 1
    fi
    for ((i = 0; i < 50; i++)); do
      HEALTH_JSON="$(health)"
      [ -z "$HEALTH_JSON" ] && break
      sleep 0.2
    done
    if [ -n "$HEALTH_JSON" ]; then
      echo "splice: stale daemon did not stop within 10 seconds" >&2
      exit 1
    fi
  fi
fi

# UNIT-FIRST cold start (hostshield law, verify.sh "splice launcher must be UNIT-FIRST"). When the
# user unit exists, the daemon is started THROUGH it and this shim only waits for health. A raw
# spawn from here runs the daemon inside the calling agent's scope, wins the startup lock and locks
# splice.service out of its own port: the unit then loops "another splice daemon serves on :3096"
# (restart counter 22,463 once; three squatters on 2026-09-21 alone, each born in the seconds a
# `systemctl restart` left the port empty, each holding a stale jar until SIGKILLed). Every
# `splice install` used to revert the unit-first patch because it lived only in the installed
# copy; it lives here now. The raw spawn below remains ONLY for a machine with no unit, or for a
# shim pointed away from the unit's defaults (SPLICE_CONFIG / SPLICE_JAR / SPLICE_SHARE_DIR /
# SPLICE_STATE_DIR / CLAUDEX_STATE_DIR set): that daemon is a harness's own, never the unit's, and
# the unit could not serve it (release/launcher-test.sh, heads and docker e2e all run that way).
unit_defaults() {
  [ -z "${SPLICE_CONFIG:-}${SPLICE_JAR:-}${SPLICE_SHARE_DIR:-}${SPLICE_STATE_DIR:-}${CLAUDEX_STATE_DIR:-}" ]
}
if [ -z "$HEALTH_JSON" ] && unit_defaults && command -v systemctl >/dev/null 2>&1 \
  && systemctl --user cat splice.service >/dev/null 2>&1; then
  echo "splice: starting splice.service…" >&2
  systemctl --user start splice.service >/dev/null 2>&1 || true
  for ((i = 0; i < 150; i++)); do
    HEALTH_JSON="$(health)"
    [ -n "$HEALTH_JSON" ] && break
    sleep 0.2
  done
  if [ -z "$HEALTH_JSON" ]; then
    echo "splice: splice.service did not answer /health within 30 seconds — never starting a second daemon beside it. See: systemctl --user status splice.service; journalctl --user -u splice.service -n 50" >&2
    exit 1
  fi
fi

if [ -z "$HEALTH_JSON" ]; then
  if [ ! -f "$JAR" ]; then
    echo "splice: daemon jar not found at $JAR (run: splice install, or set SPLICE_JAR)" >&2
    exit 1
  fi
  echo "splice: starting daemon (no splice.service on this machine)…" >&2
  mkdir -p "$LOGS_DIR" 2>/dev/null || true
  if [ -f "$BOOT_LOG" ] && [ "$(wc -c <"$BOOT_LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    mv -f "$BOOT_LOG" "$BOOT_LOG.1" 2>/dev/null || true
  fi
  # shellcheck disable=SC2086 # word-splitting of JVM opts is intentional
  if ( : >>"$BOOT_LOG" ) 2>/dev/null; then
    nohup java $SPLICE_JVM_OPTS -jar "$JAR" daemon >>"$BOOT_LOG" 2>&1 &
  else
    # a read-only home must degrade the redirect, never break launching (JW-01 risk note)
    nohup java $SPLICE_JVM_OPTS -jar "$JAR" daemon >/dev/null 2>&1 &
  fi
  for ((i = 0; i < 50; i++)); do
    HEALTH_JSON="$(health)"
    [ -n "$HEALTH_JSON" ] && break
    sleep 0.2
  done
fi
RUNNING_VERSION="$(health_field version)"
if [ "$RUNNING_VERSION" != "$SPLICE_GATEWAY_VERSION" ]; then
  echo "splice: daemon failed version handshake (expected $SPLICE_GATEWAY_VERSION, got ${RUNNING_VERSION:-<none>})" >&2
  # JW-01: the answer to "why?" is in the boot log — show it instead of making the operator
  # know to hand-run the jar.
  if [ -s "$BOOT_LOG" ]; then
    echo "splice: last boot output ($BOOT_LOG):" >&2
    tail -n 15 "$BOOT_LOG" >&2
  fi
  exit 1
fi

# Non-fatal staleness check: warn (never block) when the installed shim's marker doesn't match
# what the running daemon expects. Diagnostic only — the actual exec below always proceeds.
WANT_SHIM="$(health_field wantShimVersion)"
if [ -n "$WANT_SHIM" ] && [ -n "$SPLICE_SHIM_VERSION" ] && [ "$WANT_SHIM" != "$SPLICE_SHIM_VERSION" ]; then
  echo "splice: WARNING — installed launch shim ($0) is stale (marker=$SPLICE_SHIM_VERSION, daemon expects=$WANT_SHIM). Run: splice install (or ./install.sh) to refresh it." >&2
fi

# JW-04, same non-fatal shape: topology loads once by design, so an edited splice.toml is inert
# until a restart — the daemon re-compares its booted digest to the file per /health request
# (topologyStale, fail-open), and this names the fix instead of leaving the edit silently dead.
TOPOLOGY_STALE="$(health_field topologyStale)"
if [ "$TOPOLOGY_STALE" = "True" ] || [ "$TOPOLOGY_STALE" = "true" ]; then
  echo "splice: WARNING — splice.toml changed since the daemon booted; the running topology is stale. Run: splice restart" >&2
fi

KEY="$(cat "$KEY_FILE" 2>/dev/null || true)"
if [ -z "$KEY" ]; then echo "splice: mgmt-key not found at $KEY_FILE" >&2; exit 1; fi

# Ask the daemon for the exec recipe (env sets/unsets + argv), passing through extra args and the
# working directory (shim-4, V4-183): a bare -c is resolved by the daemon to this head's own newest
# session in this cwd, so it never continues another head's session.
ARGS_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")"
CWD_JSON="$(python3 -c 'import json,os; print(json.dumps(os.getcwd()))')"
RECIPE="$(curl -sS -X POST "${CONTROL}/launch/${HEAD}" \
  -H "Authorization: Bearer ${KEY}" -H 'Content-Type: application/json' \
  --data "{\"dangerouslySkipPermissions\":\"${DANGEROUS}\",\"cwd\":${CWD_JSON},\"args\":${ARGS_JSON}}")"

# Parse the recipe into env/unset/argv and exec. The recipe rides in $RECIPE (env), NOT stdin —
# the heredoc is python's stdin (the script), so piping the recipe in would be swallowed.
CMD="$(SPLICE_RECIPE="$RECIPE" python3 <<'PY'
import os, json, re, shlex, sys
raw = os.environ.get("SPLICE_RECIPE", "")
try:
    r = json.loads(raw)
except Exception:
    sys.stderr.write("splice: launch failed (no recipe from daemon): " + (raw or "<empty>") + "\n"); sys.exit(1)
if "argv" not in r:
    sys.stderr.write("splice: launch failed: " + json.dumps(r) + "\n"); sys.exit(1)
# The key rides into `env K=V ...` unquoted (only the value is shlex-quoted), so a key that
# isn't a bare identifier is a shell-injection vector straight from the control-plane response.
# Reject anything that doesn't look like an env-var name instead of quoting it — quoting the
# key would still let it break out via the bare `=` syntax `env` itself requires.
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
env_items = []
for k, v in r.get("env", {}).items():
    if ENV_NAME_RE.match(k):
        env_items.append((k, v))
    else:
        sys.stderr.write("splice: ignoring malformed env key from daemon: " + repr(k) + "\n")
sets = " ".join(f"{k}={shlex.quote(v)}" for k, v in env_items)
unsets = " ".join(f"-u {shlex.quote(k)}" for k in r.get("unset", []))
argv = " ".join(shlex.quote(a) for a in r["argv"])
if r.get("warning"):
    sys.stderr.write("splice: " + r["warning"] + "\n")
print(f"exec env {unsets} {sets} {argv}")
PY
)" || exit 1
eval "$CMD"
