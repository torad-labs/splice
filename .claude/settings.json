{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/tools/gate rules --stdin pretooluse",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.claude/hooks/orchestrator/pretooluse.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/tools/gate no-python --guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun $CLAUDE_PROJECT_DIR/.claude/hooks/orchestrator/sessionstart.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
