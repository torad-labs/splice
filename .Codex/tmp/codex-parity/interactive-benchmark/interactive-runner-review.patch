+// Model-free stand-in for a terminal client. Never launches a model or a native AI client.
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+const [dir, mode, client = "claude"] = process.argv.slice(2);
+if (mode === "early") process.exit(0);
+if (process.stdin.isTTY) process.stdin.setRawMode(true);
+process.stdin.resume();
+let input = "";
+let finished = false;
+let exits = 0;
+process.stdin.on("data", data => {
+  input += data.toString();
+  if (mode === "startup" && input.includes("\x1b[A\r")) { input = ""; process.stdout.write("\r\nMODEL-FREE synthetic token accepted\r\n\x1b[6n"); return; }
+  if (data.includes(4)) {
+    exits++;
+    if (mode === "double" && exits === 1) { input = ""; process.stdout.write("\r\nPress Ctrl-D again to exit\r\n"); return; }
+    process.stdout.write("\r\nMODEL-FREE clean exit\r\n"); process.exit(0);
+  }
+  if (mode === "never" || finished || !/\x1b\[\d+;\d+R/.test(input)) return;
+  finished = true;
+  writeFileSync(join(dir, "child-state.json"), JSON.stringify({ stdinTTY: process.stdin.isTTY, stdoutTTY: process.stdout.isTTY, cursorReply: true }));
+  const rows = client === "codex" ? [
+    { type: "session_meta", payload: { id: "fixture-session" } },
+    { type: "event_msg", payload: { type: "task_started" } },
+    { type: "event_msg", payload: { type: "task_complete", last_agent_message: "fixture final answer" } },
+  ] : [
+    { type: "user", sessionId: "fixture-session", message: { content: "synthetic task" } },
+    { type: "assistant", sessionId: "fixture-session", message: { stop_reason: "end_turn", content: [{ type: "text", text: "fixture final answer" }] } },
+  ];
+  writeFileSync(join(dir, "session.jsonl"), rows.map(row => JSON.stringify(row)).join("\n") + "\n");
+  process.stdout.write("\r\nMODEL-FREE final state\r\n");
+});
+process.stdout.write(mode === "startup" ? "Do you want to use this API key?\r\n" : mode === "unapproved" ? "Grant unrelated permissions?\r\n" : "MODEL-FREE genuine TTY fixture\r\n\x1b[6n");
