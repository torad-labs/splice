#!/bin/sh
# splice-launch — the wrapper the installed argv[0] symlinks (claudex, grok, …) exec.
# All logic lives in the daemon; this shim does the version handshake, cold-starts the daemon
# if down, POSTs /launch to get the exec recipe, and execs `claude` under the recipe's environment.
# Head is inferred from argv[0] (the symlink name) or $SPLICE_HEAD.
#
# POSIX sh and curl, no Node and no JSON parser. A person with Java and a native Claude Code install has no Node
# (Anthropic's installer ships Claude Code as one binary), and an interpreter the product never used itself was a
# third runtime to ask for. The daemon does the JSON: the shim writes its request with `curl --data-urlencode`, which
# puts every argv word on the wire byte for byte, and reads the answer in the line form the daemon names with
# `Accept: text/x-splice-launch` (LaunchRecipeLines.kt): one record per line, parsed with `read`, never `eval`.
# What it still reads out of JSON is the daemon's own flat /health body and the control port in config.json, both
# written by splice with plain string and number fields. Shipped by :app's installDist from app/src/main/dist/bin/.

# Hand-paired with splice.core.SHIM_VERSION (core/src/main/kotlin/splice/core/Versions.kt)
# — bump both together whenever this shim's behavior changes. No code generation.
SPLICE_SHIM_VERSION="shim-21"
# Hand-paired with splice.core.GATEWAY_VERSION. Release acceptance verifies the marker.
SPLICE_GATEWAY_VERSION="0.4.0-beta.1"

NL='
'

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}
warn() {
  printf '%s\n' "$1" >&2
}

# A wait shorter than a second, on a sleep that takes only whole seconds: one second, never none.
nap() {
  sleep "$1" 2>/dev/null || sleep 1
}

# True for an empty value or one of only whitespace: a variable holding only whitespace is NOT set (Kotlin's isNotBlank).
blank() {
  case $1 in
    *[![:space:]]*) return 1 ;;
  esac
  return 0
}

# The passwd home, which the JVM's user.home falls back to. The shell expands ~user through the passwd database.
passwd_home() {
  user=$(id -un 2>/dev/null) || user=""
  case $user in
    '' | *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  eval "printf '%s' ~$user"
}

# ENOENT alone is absence. A path whose nearest existing ancestor is not a searchable directory (ENOTDIR, EACCES)
# is UNKNOWN, and unknown is not absent: path_state answers "dir", "file" (anything else that exists) or "absent",
# and "unusable" for the unknown.
path_state() {
  if [ -d "$1" ]; then
    printf 'dir'
  elif [ -e "$1" ]; then
    printf 'file'
  else
    ps_up=$1
    while :; do
      ps_up=${ps_up%/*}
      [ -n "$ps_up" ] || ps_up=/
      if [ -e "$ps_up" ]; then
        if [ -d "$ps_up" ] && [ -x "$ps_up" ]; then printf 'absent'; else printf 'unusable'; fi
        return 0
      fi
      [ "$ps_up" = / ] && { printf 'absent'; return 0; }
    done
  fi
}

# V4-177: the state root, resolved EXACTLY as StatePaths.kt resolves it — SPLICE_STATE_DIR, then the pre-0.4
# CLAUDEX_STATE_DIR, then ~/.splice/state, adopting ~/.claude-codex/state in place when that is the only one on the
# box. Two implementations of one rule is the whole risk here: this shim reads the mgmt-key and config.json the
# daemon WRITES, so a shim that picked the other root would hand the operator "mgmt-key not found" on a perfectly
# healthy install, or cold-start a second daemon against an empty state dir while the real one is up. Keep the
# branches in step with StatePaths.kt; StateLayoutDoctorTest pins every copy against it.
# live_state_dir HOME SPLICE_STATE_DIR CLAUDEX_STATE_DIR (each "" when unset)
live_state_dir() {
  # PER VARIABLE, and blank is not an answer: a variable holding only whitespace is NOT set, and an EMPTY
  # SPLICE_STATE_DIR falls through to CLAUDEX_STATE_DIR instead of skipping it.
  if ! blank "$2"; then printf '%s' "$2"; return 0; fi
  if ! blank "$3"; then printf '%s' "$3"; return 0; fi
  # Adoption needs POSITIVE evidence on both sides: only proven absence may start a fresh root, and the pre-0.4 root
  # must be proven to be a DIRECTORY. "cannot be stat-ed" is not absence, and a REGULAR FILE at either path is not a
  # state root either.
  lsd_current=$1/.splice/state
  lsd_legacy=$1/.claude-codex/state
  lsd_cur=$(path_state "$lsd_current")
  lsd_leg=$(path_state "$lsd_legacy")
  if [ "$lsd_leg" != dir ]; then printf '%s' "$lsd_current"; return 0; fi
  if [ "$lsd_cur" = absent ]; then printf '%s' "$lsd_legacy"; return 0; fi
  # A directory is not state (StatePaths, 2026-10-04): once both state dirs exist, the mgmt-key decides. A current
  # dir proven to hold none, beside a pre-0.4 one proven to hold it, is passed over. Same three answers for the key:
  # EACCES on an untraversable dir is not absence.
  if [ "$lsd_cur" = dir ] && [ "$(path_state "$lsd_current/mgmt-key")" = absent ] &&
    [ -f "$lsd_legacy/mgmt-key" ]; then
    printf '%s' "$lsd_legacy"
  else
    printf '%s' "$lsd_current"
  fi
}

# The [daemon] control_port of a splice.toml, "" when there is none. config is the SPLICE_CONFIG value or "".
# toml_control_port HOME SPLICE_CONFIG XDG_CONFIG_HOME
toml_control_port() {
  tcp_file=$2
  if [ -z "$tcp_file" ]; then
    tcp_file=${3:-$1/.config}/splice/splice.toml
  fi
  case $tcp_file in
    "~/"*) tcp_file=$1/${tcp_file#"~/"} ;;
  esac
  [ -r "$tcp_file" ] || return 0
  awk '
    /^[ \t]*\[/ { inDaemon = ($0 ~ /^[ \t]*\[daemon\][ \t]*$/) }
    inDaemon && /^[ \t]*control_port[ \t]*=/ {
      value = $0
      sub(/^[^=]*=[ \t]*/, "", value)
      sub(/[ \t#].*$/, "", value)
      if (value ~ /^[0-9]+$/) { print value; exit }
    }
  ' "$tcp_file" 2>/dev/null
}

# The controlPort the daemon wrote into state/config.json, "" unless it is a port.
state_control_port() {
  [ -r "$1/config.json" ] || return 0
  scp_raw=$(sed -n 's/.*"controlPort"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p' "$1/config.json" 2>/dev/null | head -n 1)
  scp_raw=$(printf '%s' "$scp_raw" | tr -d '"[:space:]')
  case $scp_raw in
    '' | *[!0-9+-]* | *[+-]*[0-9]*[+-]* ) return 0 ;;
  esac
  scp_raw=${scp_raw#+}
  case $scp_raw in
    -* | '' | *[!0-9]*) return 0 ;;
  esac
  # strip leading zeros: $(( )) would read 0100 as octal
  while [ "${#scp_raw}" -gt 1 ] && [ "${scp_raw#0}" != "$scp_raw" ]; do scp_raw=${scp_raw#0}; done
  if [ "${#scp_raw}" -le 5 ] && [ "$scp_raw" -gt 0 ] && [ "$scp_raw" -le 65535 ]; then printf '%s' "$scp_raw"; fi
}

# Match ConfigService exactly: default < TOML < state/config.json < env aliases.
# control_port_for HOME STATE_DIR SPLICE_CONFIG XDG_CONFIG_HOME SPLICE_CONTROL_PORT CONTROL_PROXY_PORT
control_port_for() {
  cpf=$(toml_control_port "$1" "$3" "$4")
  cpf=${cpf:-3096}
  cpf2=$(state_control_port "$2")
  cpf=${cpf2:-$cpf}
  printf '%s' "${5:-${6:-$cpf}}"
}

# Replaces this process: the launched program is the terminal's foreground job, not a child of the shim. The
# recipe's environment is already exported, so exec's PATH search is the recipe's.
exec_argv() {
  if ! command -v "$1" >/dev/null 2>&1; then fail "splice: $1: command not found on PATH"; fi
  exec "$@"
}

# A launch inside tmux records its pane and the tmux server's socket with it, so the console can drive the session
# it runs (console TMUX.md, Oct 8). $TMUX is "<socket>,<server pid>,<session>"; a socket path with a comma in it is
# not one splice can name, and the launch is recorded without a terminal.
terminal_pane() {
  [ -n "${TMUX_PANE-}" ] || return 1
  case ${TMUX-} in
    /*,*,*)
      tp_rest=${TMUX#*,}
      case $tp_rest in
        *,*,*) return 1 ;;
        *,*) return 0 ;;
      esac
      ;;
  esac
  return 1
}

# record_launch HEAD BASE_URL KIND — ownership by this process's pid, which exec keeps.
record_launch() {
  if terminal_pane && [ "$3" = session ]; then
    SPLICE_STATE_DIR=$STATE_DIR java -Djdk.console=java.base "-Duser.home=$SHIM_HOME" -jar "$JAR" record-launch "$$" \
      "$1" "$2" "$3" "$([ "${SPLICE_LOGIN_ORIGIN-}" = hook ] && echo hook || echo other)" "$TMUX_PANE" "${TMUX%%,*}" \
      >/dev/null 2>&1 </dev/null
  else
    SPLICE_STATE_DIR=$STATE_DIR java -Djdk.console=java.base "-Duser.home=$SHIM_HOME" -jar "$JAR" record-launch "$$" \
      "$1" "$2" "$3" "$([ "${SPLICE_LOGIN_ORIGIN-}" = hook ] && echo hook || echo other)" \
      >/dev/null 2>&1 </dev/null
  fi || warn "splice: launch ownership could not be recorded; this session may have an unknown head on macOS"
}

need_jar() {
  [ -f "$JAR" ] || fail "splice: jar not found at $JAR (run: splice install, or set SPLICE_JAR)"
}

need_curl() {
  command -v curl >/dev/null 2>&1 ||
    fail "splice: needs curl to start Claude Code, and it isn't installed. Install curl (apt install curl, brew install curl, dnf install curl), then launch again"
}

# `splice login <head> [--label NAME] [--discard]` names the head it signs in: the one positional word.
login_head() {
  lh_count=0
  lh_head=""
  while [ $# -gt 0 ]; do
    case $1 in
      --label) shift ;;
      --discard) ;;
      *) lh_count=$((lh_count + 1)); lh_head=$1 ;;
    esac
    shift
  done
  [ "$lh_count" -eq 1 ] && printf '%s' "$lh_head"
}

# The path of the file the launcher name really is, symlinks followed (readlink -f is not on every system).
real_path() {
  rp_file=$1
  rp_hops=0
  while [ -L "$rp_file" ] && [ "$rp_hops" -lt 40 ]; do
    rp_target=$(readlink "$rp_file") || break
    case $rp_target in
      /*) rp_file=$rp_target ;;
      *) rp_file=$(dirname "$rp_file")/$rp_target ;;
    esac
    rp_hops=$((rp_hops + 1))
  done
  printf '%s' "$rp_file"
}

# One path's canonical spelling: the directory followed, or the path as it stands when it does not exist.
canonical_dir() {
  (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"
}

same_home() {
  [ -n "$1" ] || return 1
  [ "$(canonical_dir "$HOME_FOR_SAME")" = "$(canonical_dir "$1")" ]
}

# Two spellings of one port: 3096 and 03096 name the same listener, so the comparison is numeric. Anything that is not
# all digits is only equal to itself.
same_port() {
  case $1$2 in
    '' | *[!0-9]*) [ "$1" = "$2" ]; return ;;
  esac
  sp_a=$1
  sp_b=$2
  while [ "${#sp_a}" -gt 1 ] && [ "${sp_a#0}" != "$sp_a" ]; do sp_a=${sp_a#0}; done
  while [ "${#sp_b}" -gt 1 ] && [ "${sp_b#0}" != "$sp_b" ]; do sp_b=${sp_b#0}; done
  [ "$sp_a" = "$sp_b" ]
}

# One flat string field of a JSON file splice itself wrote ("" when it is not there). A value holding a quote or a
# backslash is not read: the callers treat an empty answer as a record they cannot use.
json_string() {
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' "$2" 2>/dev/null | head -n 1
}

# ---- the environment this launch runs in -------------------------------------------------------------------

SELF=$0
HEAD=${SPLICE_HEAD:-${SELF##*/}}
[ "$HEAD" = "splice-launch" ] && HEAD=claudex

# Match UserHome: whitespace is not a home. The shim leaves HOME itself alone, since the launched program must see
# the caller's own environment, and uses SHIM_HOME for its own paths.
if blank "${HOME-}"; then
  SHIM_HOME=$(passwd_home) || SHIM_HOME=""
else
  SHIM_HOME=$HOME
fi
HOME_FOR_SAME=$SHIM_HOME

STATE_DIR=$(live_state_dir "$SHIM_HOME" "${SPLICE_STATE_DIR-}" "${CLAUDEX_STATE_DIR-}")

# Remembered before the resolution below: an inherited CONTROL_PORT is a caller-local endpoint selector, and the
# unit-first cold start must not answer it (unit_defaults).
CONTROL_PORT_FROM_ENV=${CONTROL_PORT:-}
CONTROL_PORT=$(control_port_for "$SHIM_HOME" "$STATE_DIR" "${SPLICE_CONFIG-}" "${XDG_CONFIG_HOME-}" "${SPLICE_CONTROL_PORT-}" "${CONTROL_PROXY_PORT-}")
CONTROL="http://127.0.0.1:$CONTROL_PORT"
JAR=${SPLICE_JAR:-${SPLICE_SHARE_DIR:-$SHIM_HOME/.local/share/splice}/splice.jar}
# Bounded heap by default (a 1000-stream fleet with unbounded per-stream buffers OOMs the JVM default); override with
# SPLICE_JVM_OPTS. Used for every daemon cold-start below. 2G rides out a full 48-inflight + 512-queue burst.
SPLICE_JVM_OPTS=${SPLICE_JVM_OPTS:-"-Xmx2048m -XX:+UseStringDeduplication -XX:G1PeriodicGCInterval=60000"}
# JW-01: the spawned JVM's output lands here, never /dev/null — a boot-dead daemon must leave a tailable stack trace.
# One rolled generation at 1MB, same cap discipline as daemon.log.
LOGS_DIR=$STATE_DIR/../logs
BOOT_LOG=$LOGS_DIR/daemon-boot.log
# V4-258: DaemonLaunch.kt's BOOT_LOG_FLAG, the argument both cold-start paths pass.
BOOT_LOG_FLAG=--stderr-is-boot-log
KEY_FILE=$STATE_DIR/mgmt-key
# Safe by default: the daemon never adds --dangerously-skip-permissions unless explicitly told to.
if [ "${CLAUDEX_DANGEROUSLY_SKIP_PERMISSIONS-}" = 1 ]; then DANGEROUS=true; else DANGEROUS=false; fi

# Required daemon diagnostics follow the caller's options, so a custom heap does not disable them. The resolved dump
# path is one argv item, never split with the caller's whitespace-delimited options. Runs in a function: it
# rebuilds the positional parameters, and the caller's are not its own.
exec_cli() {
  if [ "${1-}" = daemon ]; then
    set -f
    # shellcheck disable=SC2086
    set -- -Djdk.console=java.base "-Duser.home=$SHIM_HOME" $SPLICE_JVM_OPTS -XX:+ExitOnOutOfMemoryError \
      -XX:+HeapDumpOnOutOfMemoryError "-XX:HeapDumpPath=$STATE_DIR/splice-oom.hprof" -jar "$JAR" "$@"
    set +f
  else
    set -- -Djdk.console=java.base "-Duser.home=$SHIM_HOME" -jar "$JAR" "$@"
  fi
  exec_argv java "$@"
}

# ---- the admin command, and sign-in ------------------------------------------------------------------------

# Invoked as `splice` (the admin command): pass every subcommand straight to the CLI
# (setup, status, dashboard, login <head>, install, …). The CLI self-manages the daemon.
if [ "$HEAD" = splice ]; then
  need_jar
  if [ "${1-}" = login ]; then
    shift
    head=$(login_head "$@")
    set -- login "$@"
    [ -n "$head" ] && record_launch "$head" "" login
  fi
  exec_cli "$@"
fi

# `<command> login [--label NAME]` runs the OAuth browser flow for this head directly (no daemon needed); the
# arguments after `login` go to the CLI unchanged (v0.4.0: --label signs in another account of this head's kind).
head_login() {
  need_jar
  shift
  record_launch "$HEAD" "" login
  set -- -Djdk.console=java.base "-Duser.home=$SHIM_HOME" -jar "$JAR" login "$HEAD" "$@"
  exec_argv java "$@"
}
if [ "${1-}" = login ] && [ "$HEAD" != claude ]; then head_login "$@"; fi

# ---- talking to the daemon ---------------------------------------------------------------------------------

HEALTH_JSON=""

# The body of one GET, "" on a connection failure or after the timeout, whatever the status.
health() {
  curl -s -m 2 "$CONTROL/health" 2>/dev/null || true
}

# A string field of the last /health body: "" when it is not there or is empty. The body is the daemon's own flat
# JSON, and its first "version" is the top-level one.
health_field() {
  printf '%s' "$HEALTH_JSON" |
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

health_true() {
  printf '%s' "$HEALTH_JSON" | grep -q '"'"$1"'"[[:space:]]*:[[:space:]]*true'
}

read_key() {
  [ -r "$KEY_FILE" ] || return 0
  # shellcheck disable=SC2005
  echo "$(cat "$KEY_FILE" 2>/dev/null)"
}

wait_for_health() {
  wfh_left=$1
  while [ "$wfh_left" -gt 0 ]; do
    HEALTH_JSON=$(health)
    [ -n "$HEALTH_JSON" ] && break
    nap 0.2
    wfh_left=$((wfh_left - 1))
  done
}

# Fail-closed boot, ahead of the stop: the NEW jar boots only on a splice.toml it finds no fault in, so it is asked
# first (`check-config`, which reads and reports and writes nothing). A refusal leaves the running daemon up and ends
# this launch with the whole list. Only a clean exit lets the stop go ahead: a jar that has no such verb, or no java
# at all, gives no verdict, and no verdict keeps the serving daemon too.
CONFIG_REFUSED_EXIT=3
refuse_unbootable_config() {
  if command -v timeout >/dev/null 2>&1; then
    ruc_out=$(timeout 60 java "-Duser.home=$SHIM_HOME" -jar "$JAR" check-config 2>/dev/null </dev/null)
  else
    ruc_out=$(java "-Duser.home=$SHIM_HOME" -jar "$JAR" check-config 2>/dev/null </dev/null)
  fi
  ruc_rc=$?
  [ "$ruc_rc" -eq 0 ] && return 0
  if [ "$ruc_rc" -eq "$CONFIG_REFUSED_EXIT" ]; then
    fail "$ruc_out${NL}splice: the running $1 daemon was not stopped; fix splice.toml, then launch again"
  fi
  # ONLY a clean exit permits the replacement. A check that could not run (no java, a crash, a timeout, a build that
  # does not know the verb) is no verdict, and no verdict keeps the serving daemon, same as a refusal does.
  fail "splice: could not check splice.toml with $SPLICE_GATEWAY_VERSION (exit $ruc_rc), so the running $1 daemon was not stopped; fix that, then launch again"
}

# The mgmt-key as curl's own config on stdin, so it never rides in an argv another user's `ps` can read.
auth_config() {
  printf 'header = "Authorization: Bearer %s"\n' "$1"
}

# A listener is valid only when it is splice and its version matches the installed JAR/shim. New daemons can shut
# themselves down cleanly for an automatic upgrade. Legacy daemons without that route fail loudly instead of
# silently serving an incompatible API forever.
replace_stale_daemon() {
  rsd_running=$(health_field version)
  [ -n "$rsd_running" ] || fail "splice: port $CONTROL_PORT is occupied by a non-splice or malformed health endpoint"
  [ "$rsd_running" = "$SPLICE_GATEWAY_VERSION" ] && return 0
  rsd_key=$(read_key)
  [ -n "$rsd_key" ] || fail "splice: daemon version $rsd_running is stale, but $KEY_FILE is unavailable; stop it and retry"
  refuse_unbootable_config "$rsd_running"
  warn "splice: replacing stale daemon $rsd_running with $SPLICE_GATEWAY_VERSION…"
  rsd_status=$(auth_config "$rsd_key" | curl -s -m 3 -K - -X POST -o /dev/null -w '%{http_code}' "$CONTROL/api/daemon/shutdown" 2>/dev/null) || rsd_status=000
  case $rsd_status in
    000 | [45]??) fail "splice: stale daemon cannot self-stop; terminate it once, then retry" ;;
  esac
  rsd_left=50
  while [ "$rsd_left" -gt 0 ]; do
    HEALTH_JSON=$(health)
    [ -z "$HEALTH_JSON" ] && break
    nap 0.2
    rsd_left=$((rsd_left - 1))
  done
  [ -z "$HEALTH_JSON" ] || fail "splice: stale daemon did not stop within 10 seconds"
}

# UNIT-FIRST cold start (a host requirement: the supervising unit owns the daemon's process). When the user unit
# serves this HOME, the daemon is started THROUGH it and this shim only waits for health. A raw spawn on the unit's
# port would squat beside it (restart counter 22,463 once). An alternate HOME is a different profile: it may raw-spawn
# only on a different control port, checked BEFORE health can accept a same-version daemon from the unit's home. The
# other selectors below likewise identify a harness's own daemon. The unit is SPLICE_SUPERVISOR_UNIT (default
# splice.service).
unit_defaults() {
  for ud in "${SPLICE_CONFIG-}" "${XDG_CONFIG_HOME-}" "${SPLICE_JAR-}" "${SPLICE_SHARE_DIR-}" "${SPLICE_STATE_DIR-}" \
    "${CLAUDEX_STATE_DIR-}" "${SPLICE_CONTROL_PORT-}" "${CONTROL_PROXY_PORT-}" "$CONTROL_PORT_FROM_ENV"; do
    [ -z "$ud" ] || return 1
  done
  return 0
}

# systemctl --user finds the user manager through XDG_RUNTIME_DIR or DBUS_SESSION_BUS_ADDRESS. A shell outside a login
# session (su, sudo -u, cron) has neither, and every user verb failed as if there were no unit, so the shim ran the
# daemon in the shell beside the unit. The manager's runtime dir is /run/user/<uid> (pam_systemd); the JVM's
# UserManagerBus supplies the same, so the two cold-start paths agree.
user_systemctl() {
  if [ -z "${XDG_RUNTIME_DIR-}" ] && [ -z "${DBUS_SESSION_BUS_ADDRESS-}" ] && [ -d "/run/user/$(id -u)" ]; then
    XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user "$@"
  else
    systemctl --user "$@"
  fi
}

unit_exists() {
  user_systemctl cat "$1" >/dev/null 2>&1
}

# Read only the manager's path selectors: its HOME and control port define the user unit's profile. Do not print
# show-environment: other variables in it may contain credentials. Sets MANAGED_* and answers whether it could be read.
read_unit_environment() {
  rue_text=$(user_systemctl show-environment 2>/dev/null) || return 1
  MANAGED_HOME=""
  MANAGED_SPLICE_CONFIG=""
  MANAGED_XDG_CONFIG_HOME=""
  MANAGED_SPLICE_STATE_DIR=""
  MANAGED_CLAUDEX_STATE_DIR=""
  MANAGED_SPLICE_CONTROL_PORT=""
  MANAGED_CONTROL_PROXY_PORT=""
  while IFS= read -r rue_line; do
    rue_value=${rue_line#*=}
    case $rue_line in
      HOME=*) MANAGED_HOME=$rue_value ;;
      SPLICE_CONFIG=*) MANAGED_SPLICE_CONFIG=$rue_value ;;
      XDG_CONFIG_HOME=*) MANAGED_XDG_CONFIG_HOME=$rue_value ;;
      SPLICE_STATE_DIR=*) MANAGED_SPLICE_STATE_DIR=$rue_value ;;
      CLAUDEX_STATE_DIR=*) MANAGED_CLAUDEX_STATE_DIR=$rue_value ;;
      SPLICE_CONTROL_PORT=*) MANAGED_SPLICE_CONTROL_PORT=$rue_value ;;
      CONTROL_PROXY_PORT=*) MANAGED_CONTROL_PROXY_PORT=$rue_value ;;
    esac
  done <<EOF
$rue_text
EOF
  blank "$MANAGED_HOME" && MANAGED_HOME=$(passwd_home)
  return 0
}

start_through_unit() {
  # start_through_unit UNIT MANAGER_HOME PRESENT
  [ -z "$HEALTH_JSON" ] && [ "$3" = 1 ] && same_home "$2" && unit_defaults || return 0
  warn "splice: starting $1…"
  # The line below is the literal unit-first form a host's launcher check looks for: a line that begins
  # `systemctl --user start "$SUPERVISOR_UNIT"`. tools/release/test/launcher.test.ts holds the shipped shim to it. The
  # user-bus fallback of user_systemctl is kept in the subshell, so the XDG_RUNTIME_DIR it sets never reaches the program
  # this shim execs.
  SUPERVISOR_UNIT=$1
  (
    if [ -z "${XDG_RUNTIME_DIR-}" ] && [ -z "${DBUS_SESSION_BUS_ADDRESS-}" ] && [ -d "/run/user/$(id -u)" ]; then
      XDG_RUNTIME_DIR=/run/user/$(id -u)
      export XDG_RUNTIME_DIR
    fi
    systemctl --user start "$SUPERVISOR_UNIT" >/dev/null 2>&1
  ) || true # the wait below reports the outcome; a failed start never answers
  # Wall clock, not iterations: health() itself may block up to its timeout per probe, so a probe count is not a
  # deadline. SPLICE_UNIT_WAIT_SECONDS raises it on a box whose JVM boots slowly.
  stu_wait=${SPLICE_UNIT_WAIT_SECONDS:-30}
  case $stu_wait in '' | *[!0-9]*) stu_wait=30 ;; esac
  stu_deadline=$(($(date +%s) + stu_wait))
  while [ "$(date +%s)" -lt "$stu_deadline" ]; do
    HEALTH_JSON=$(health)
    [ -n "$HEALTH_JSON" ] && break
    nap 0.2
  done
  if [ -z "$HEALTH_JSON" ]; then
    fail "splice: $1 did not answer /health within ${stu_wait}s; never starting a second daemon beside it. See: systemctl --user status $1; journalctl --user -u $1 -n 50"
  fi
}

cold_start() {
  [ -z "$HEALTH_JSON" ] || return 0
  [ -f "$JAR" ] || fail "splice: daemon jar not found at $JAR (run: splice install, or set SPLICE_JAR)"
  warn "splice: starting…"
  mkdir -p "$LOGS_DIR" 2>/dev/null || true # an unwritable home degrades the redirect below, never the launch
  if [ -f "$BOOT_LOG" ] && [ "$(wc -c <"$BOOT_LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
    mv "$BOOT_LOG" "$BOOT_LOG.1" 2>/dev/null || true
  fi
  # A read-only home must degrade the redirect, never break launching (JW-01 risk note). shim-21: the boot log is
  # owner-only before the daemon appends to it, as the daemon's own restart holds it (682bdbd0d): a new one is created
  # 0600 and one already there is tightened, since a boot can write each launch's --settings into it. A log that cannot
  # be made owner-only is not written at all.
  if (umask 077 && : >>"$BOOT_LOG") 2>/dev/null && chmod 600 "$BOOT_LOG" 2>/dev/null; then
    cs_log=$BOOT_LOG
    cs_flag=$BOOT_LOG_FLAG
  else
    cs_log=/dev/null
    cs_flag=""
  fi
  if ! command -v java >/dev/null 2>&1; then
    # A java that cannot be run leaves no JVM output, so the boot log says so itself (nohup used to): the handshake
    # below shows the tail, and this line is what it has to show.
    printf "splice: failed to run command 'java': not found on PATH\n" >>"$cs_log" 2>/dev/null || true
  else
    cold_start_java "$cs_log" "$cs_flag"
  fi
  wait_for_health 50
}

# The daemon, detached: its own session when setsid is there, so a ^C at this terminal does not reach it.
cold_start_java() {
  csj_log=$1
  csj_flag=$2
  set -f
  # shellcheck disable=SC2086
  set -- "-Duser.home=$SHIM_HOME" $SPLICE_JVM_OPTS -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError \
    "-XX:HeapDumpPath=$STATE_DIR/splice-oom.hprof" -jar "$JAR" daemon ${csj_flag:+"$csj_flag"}
  set +f
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup java "$@" >>"$csj_log" 2>&1 </dev/null &
  else
    nohup java "$@" >>"$csj_log" 2>&1 </dev/null &
  fi
}

# The shim generation as a number: shim-19 is 19. Empty when the text is not that shape.
shim_number() {
  case $1 in
    shim-*[!0-9]* | shim-) ;;
    shim-*) echo "${1#shim-}" ;;
  esac
}

# A daemon of the same release number can still be an earlier build that cannot read this launcher's launch request
# (the line form arrived with shim-19). The daemon reports the shim generation it serves; an older one than this
# launcher is named and the launch stops, instead of sending a request the daemon would answer with an error body.
require_daemon_current() {
  rdc_want=$(shim_number "$(health_field wantShimVersion)")
  rdc_mine=$(shim_number "$SPLICE_SHIM_VERSION")
  [ -n "$rdc_want" ] && [ -n "$rdc_mine" ] && [ "$rdc_want" -lt "$rdc_mine" ] || return 0
  fail "splice: the running daemon is an earlier build than this launcher (it serves shim-$rdc_want, this is $SPLICE_SHIM_VERSION). Restart it so it serves the installed build, then launch again:  splice restart"
}

handshake() {
  hs_running=$(health_field version)
  [ "$hs_running" = "$SPLICE_GATEWAY_VERSION" ] && { require_daemon_current; return 0; }
  warn "splice: daemon failed version handshake (expected $SPLICE_GATEWAY_VERSION, got ${hs_running:-<none>})"
  # JW-01: the answer to "why?" is in the boot log — show it instead of making the operator know to hand-run the jar.
  hs_boot=$(tail -n 15 "$BOOT_LOG" 2>/dev/null)
  if [ -n "$hs_boot" ]; then
    warn "splice: last boot output ($BOOT_LOG):"
    warn "$hs_boot"
  fi
  exit 1
}

warnings() {
  # Non-fatal staleness check: warn (never block) when the installed shim's marker doesn't match what the running
  # daemon expects. Diagnostic only — the actual exec below always proceeds.
  w_want=$(health_field wantShimVersion)
  if [ -n "$w_want" ] && [ "$w_want" != "$SPLICE_SHIM_VERSION" ]; then
    warn "splice: WARNING: installed launch shim ($SELF) is stale (marker=$SPLICE_SHIM_VERSION, daemon expects=$w_want). Run ./install.sh from a checkout, or re-run the release installer, to refresh it."
  fi
  # JW-04, same non-fatal shape: topology loads once by design, so an edited splice.toml is inert until a restart —
  # the daemon re-compares its booted digest to the file per /health request (topologyStale, fail-open), and this
  # names the fix instead of leaving the edit silently dead.
  if health_true topologyStale; then
    warn "splice: WARNING: splice.toml changed since the daemon booted; the running topology is stale. Run: splice restart"
  fi
}

# How many more times a launch is tried after the daemon answers 529, waiting 0.2 s, 0.4 s, 0.8 s and on to 2 s
# between tries. A 529 means the gateway was busy at that instant, not that this launch is wrong.
LAUNCH_BUSY_DELAYS="0.2 0.4 0.8 1.6 2 2 2 2"

# Asks the daemon for the exec recipe (env sets/unsets + argv), passing through the arguments and the working
# directory (shim-4, V4-183): a bare -c is resolved by the daemon to this head's own newest session in this cwd, so it
# never continues another head's session. Answers the recipe text in LAUNCH_RECIPE, or fails with what the daemon said.
request_launch() {
  rl_key=$(read_key)
  [ -n "$rl_key" ] || fail "splice: mgmt-key not found at $KEY_FILE"
  # curl states the body's length itself, so the daemon's heap ingress never meets a chunked body of unknown size
  # (which it charges at its whole cap, and which refused concurrent launches with 529).
  rl_count=$#
  set -- "$@" # (the words are rotated into curl's own arguments below)
  rl_i=0
  while [ "$rl_i" -lt "$rl_count" ]; do
    rl_word=$1
    shift
    set -- "$@" --data-urlencode "arg=$rl_word"
    rl_i=$((rl_i + 1))
  done
  set -- --data-urlencode "dangerouslySkipPermissions=$DANGEROUS" --data-urlencode "cwd=$(pwd -P)" "$@"
  # shim-20, MCP hub step 6: this shell's pid, which exec keeps for Claude Code, names the launch to the hub.
  set -- --data-urlencode "launch=$$" "$@"
  if [ -n "${CLAUDE_CONFIG_DIR+x}" ]; then set -- --data-urlencode "inheritedConfigDir=$CLAUDE_CONFIG_DIR" "$@"; fi
  rl_try=0
  rl_delays=$LAUNCH_BUSY_DELAYS
  while :; do
    rl_out=$(auth_config "$rl_key" | curl -s -K - -H 'Accept: text/x-splice-launch' \
      -w "${NL}SPLICE_HTTP_STATUS=%{http_code}" "$@" "$CONTROL/launch/$HEAD" 2>/dev/null) || true
    rl_status=${rl_out##*SPLICE_HTTP_STATUS=}
    rl_body=${rl_out%"${NL}SPLICE_HTTP_STATUS="*}
    [ "$rl_status" = 529 ] && [ -n "$rl_delays" ] || break
    nap "${rl_delays%% *}"
    case $rl_delays in *" "*) rl_delays=${rl_delays#* } ;; *) rl_delays="" ;; esac
    rl_try=$((rl_try + 1))
  done
  case $rl_body in
    "splice-launch 1"*) LAUNCH_RECIPE=$rl_body ;;
    *) fail "splice: launch failed (no recipe from daemon): ${rl_body:-<empty>}" ;;
  esac
}

# What the daemon wrote for one value: \\, \n and \r (LaunchRecipeLines.escape), answered in UNESCAPED and not printed:
# a command substitution would strip a trailing newline the value really has. The x after it keeps that newline alive
# through this one.
unescape() {
  un_value=$(printf '%bx' "$1")
  UNESCAPED=${un_value%x}
}

# An ANTHROPIC_AUTH_TOKEN this shell inherited that is one of this daemon's own keys (the management key, or the turn
# key every non-native head plants in its sessions) is splice's, never the caller's: a launch from inside such a session,
# as a headless read a seat starts, would carry it to a head that forwards the caller's credential, which refuses it 401
# and Claude Code retries until its caller gives up (Temple read, Oct 13 2:22 PM CT: 22 refusals in 9.5 min, 204 that
# day). It is dropped before the recipe applies, so a head that plants its own token still sets it below, and a token the
# person set themselves rides on untouched. Values are compared in this shell only, never printed or sent.
drop_own_token() {
  [ -n "${ANTHROPIC_AUTH_TOKEN-}" ] || return 0
  dot_turn=""
  [ -r "$STATE_DIR/turn-auth-header" ] && dot_turn=$(sed -n 's/^Authorization: Bearer //p' "$STATE_DIR/turn-auth-header" 2>/dev/null)
  dot_mgmt=$(read_key)
  if { [ -n "$dot_turn" ] && [ "$ANTHROPIC_AUTH_TOKEN" = "$dot_turn" ]; } ||
    { [ -n "$dot_mgmt" ] && [ "$ANTHROPIC_AUTH_TOKEN" = "$dot_mgmt" ]; }; then
    unset ANTHROPIC_AUTH_TOKEN
  fi
  dot_turn=""
  dot_mgmt=""
}

# Reads LAUNCH_RECIPE into the environment (exports and unsets, by name) and the positional parameters (the argv), and
# runs it: a function's positional parameters are its own, so the argv has to be exec'd from in here.
# A name that is not a bare identifier is not an environment variable: it is rejected here, never handed on.
apply_recipe() {
  drop_own_token
  ar_argc=0
  ar_warning=""
  ar_end=0
  set --
  while IFS= read -r ar_line; do
    case $ar_line in
      "splice-launch 1") ;;
      "U "*)
        ar_name=${ar_line#U }
        case $ar_name in
          '' | [0-9]* | *[!A-Za-z0-9_]*) warn "splice: ignoring malformed env key from daemon: '$ar_name'" ;;
          *) unset "$ar_name" ;;
        esac
        ;;
      "E "*)
        ar_rest=${ar_line#E }
        ar_name=${ar_rest%%=*}
        case $ar_name in
          '' | [0-9]* | *[!A-Za-z0-9_]*) warn "splice: ignoring malformed env key from daemon: '$ar_name'" ;;
          *) unescape "${ar_rest#*=}"; export "$ar_name=$UNESCAPED" ;;
        esac
        ;;
      "A "*)
        unescape "${ar_line#A }"
        set -- "$@" "$UNESCAPED"
        ar_argc=$((ar_argc + 1))
        ;;
      "W "*) unescape "${ar_line#W }"; ar_warning=$UNESCAPED ;;
      end) ar_end=1 ;;
    esac
  done <<EOF
$LAUNCH_RECIPE
EOF
  [ "$ar_end" -eq 1 ] && [ "$ar_argc" -gt 0 ] || fail "splice: launch failed: the recipe from the daemon is cut short"
  [ -z "$ar_warning" ] || warn "splice: $ar_warning"
  record_launch "$HEAD" "${ANTHROPIC_BASE_URL-}" session
  exec_argv "$@"
}

# The plain wrapped command still means Claude Code in a scratch HOME. Its owning profile records the real binary;
# PATH would find this wrapper again. Named splice heads keep their isolation rule.
unwrapped_claude() {
  # unwrapped_claude PROFILE_HOME PROFILE_SPLICE_STATE_DIR PROFILE_CLAUDEX_STATE_DIR, then the caller's words
  uc_state=$(live_state_dir "$1" "$2" "$3")
  shift 3
  uc_file=$uc_state/claude-head-wrap.json
  [ -r "$uc_file" ] || fail "splice: wrapped Claude's wrap state is missing or unreadable; no daemon was contacted"
  # A file that is not a JSON object is no wrap state at all, which is not the same finding as one with no binary in it.
  uc_text=$(tr -d '[:space:]' <"$uc_file" 2>/dev/null)
  case $uc_text in
    "{"*"}") ;;
    *) fail "splice: wrapped Claude's wrap state is missing or unreadable; no daemon was contacted" ;;
  esac
  uc_binary=$(json_string real_binary_path "$uc_file")
  case $uc_binary in
    /*) ;;
    *) fail "splice: wrapped Claude's recorded real binary is missing or invalid; no daemon was contacted" ;;
  esac
  if [ ! -x "$uc_binary" ] || [ ! -f "$uc_binary" ]; then
    fail "splice: wrapped Claude's recorded real binary is missing or not executable; no daemon was contacted"
  fi
  if [ "$uc_binary" -ef "$SELF" ]; then
    fail "splice: wrapped Claude's recorded real binary is the launcher itself; no daemon was contacted"
  fi
  warn "splice: another HOME's wrapped claude is running Claude Code unwrapped"
  exec_argv "$uc_binary" "$@"
}

# Wrap publishes this locator before replacing claude, and reconcile backfills older wraps. It lives beside the real
# launcher, so caller HOME, runtime and bus selectors cannot relocate it. Sets OWNER_* and answers whether there is one.
read_launcher_owner() {
  lo_real=$(real_path "$SELF")
  lo_file=$(cd "$(dirname "$lo_real")" 2>/dev/null && pwd -P)/splice-launch-owner.json
  [ -e "$lo_file" ] || return 1
  [ -r "$lo_file" ] || fail "splice: launcher's owner record is unreadable; no daemon was contacted"
  OWNER_HOME=$(json_string home "$lo_file")
  OWNER_STATE_DIR=$(json_string state_dir "$lo_file")
  case $OWNER_HOME in /*) ;; *) fail "splice: launcher's owner record is invalid; no daemon was contacted" ;; esac
  case $OWNER_STATE_DIR in /*) ;; *) fail "splice: launcher's owner record is invalid; no daemon was contacted" ;; esac
  OWNER_SPLICE_CONFIG=$(json_string SPLICE_CONFIG "$lo_file")
  OWNER_XDG_CONFIG_HOME=$(json_string XDG_CONFIG_HOME "$lo_file")
  OWNER_SPLICE_CONTROL_PORT=$(json_string SPLICE_CONTROL_PORT "$lo_file")
  OWNER_CONTROL_PROXY_PORT=$(json_string CONTROL_PROXY_PORT "$lo_file")
  return 0
}

# True when the launcher itself was installed inside this HOME (`splice install` puts it at ~/.local/share/splice): a
# launcher its own HOME holds is owned by that HOME even before the first daemon start has minted a management key and
# before any wrapped claude has written an owner record. A launcher outside this HOME is still unproven.
launcher_under_home() {
  luh_real=$(real_path "$SELF")
  luh_dir=$(cd "$(dirname "$luh_real")" 2>/dev/null && pwd -P) || return 1
  luh_home=$(canonical_dir "$HOME_FOR_SAME")
  [ -n "$luh_home" ] || return 1
  case $luh_dir in "$luh_home"/*) return 0 ;; esac
  return 1
}

main() {
  if read_launcher_owner; then has_owner=1; else has_owner=0; fi
  if [ "$has_owner" = 1 ] && [ "$HEAD" = claude ] && ! same_home "$OWNER_HOME"; then
    unwrapped_claude "$OWNER_HOME" "$OWNER_STATE_DIR" "" "$@"
  fi
  unit=${SPLICE_SUPERVISOR_UNIT:-splice.service}
  present=0
  managed=0
  if unit_exists "$unit"; then
    present=1
    read_unit_environment && managed=1
  fi
  if [ "$managed" = 0 ] && { [ "$has_owner" = 0 ] || ! same_home "$OWNER_HOME"; } && [ -z "$(read_key)" ] && ! launcher_under_home; then
    fail "splice: cannot establish this launcher's owning HOME or this HOME's splice state; no daemon was contacted"
  fi
  # The profile that owns this launcher: its recorded owner, else the unit manager's own environment.
  profile=none
  if [ "$has_owner" = 1 ]; then
    profile=owner
    PROFILE_HOME=$OWNER_HOME
  elif [ "$managed" = 1 ]; then
    profile=managed
    PROFILE_HOME=$MANAGED_HOME
  fi
  if [ "$profile" != none ] && [ "$HEAD" = claude ] && ! same_home "$PROFILE_HOME"; then
    if [ "$profile" = owner ]; then
      unwrapped_claude "$OWNER_HOME" "$OWNER_STATE_DIR" "" "$@"
    else
      unwrapped_claude "$MANAGED_HOME" "$MANAGED_SPLICE_STATE_DIR" "$MANAGED_CLAUDEX_STATE_DIR" "$@"
    fi
  fi
  if [ "${1-}" = login ]; then head_login "$@"; fi
  if [ "$profile" != none ] && ! same_home "$PROFILE_HOME"; then
    if [ "$profile" = owner ]; then
      pp=$(control_port_for "$OWNER_HOME" "$OWNER_STATE_DIR" "$OWNER_SPLICE_CONFIG" "$OWNER_XDG_CONFIG_HOME" "$OWNER_SPLICE_CONTROL_PORT" "$OWNER_CONTROL_PROXY_PORT")
    else
      mstate=$(live_state_dir "$MANAGED_HOME" "$MANAGED_SPLICE_STATE_DIR" "$MANAGED_CLAUDEX_STATE_DIR")
      pp=$(control_port_for "$MANAGED_HOME" "$mstate" "$MANAGED_SPLICE_CONFIG" "$MANAGED_XDG_CONFIG_HOME" "$MANAGED_SPLICE_CONTROL_PORT" "$MANAGED_CONTROL_PROXY_PORT")
    fi
    if same_port "$CONTROL_PORT" "$pp"; then
      fail "splice: $unit belongs to another HOME on port $CONTROL_PORT; set SPLICE_CONTROL_PORT to an isolated port"
    fi
  fi
  need_curl
  HEALTH_JSON=$(health)
  [ -z "$HEALTH_JSON" ] || replace_stale_daemon
  if [ "$managed" = 1 ]; then start_through_unit "$unit" "$MANAGED_HOME" "$present"; else start_through_unit "$unit" "" "$present"; fi
  cold_start
  handshake
  warnings
  request_launch "$@"
  apply_recipe
}

# A test sources this file for its functions and runs none of it.
if [ -n "${SPLICE_LAUNCH_FUNCTIONS_ONLY-}" ]; then return 0 2>/dev/null || exit 0; fi

main "$@"
