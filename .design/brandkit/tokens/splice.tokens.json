      },
      "dusk": {
        "$type": "color",
        "$value": "#724C5E",
        "rgb": [
          114,
          76,
          94
        ],
        "$description": "Dusk: Alternate background for end cards and the GitHub preview only.",
        "source": "video end-card background, sampled #724C5E"
      }
    },
    "ink": {
      "cream-body": {
        "$type": "color",
        "$value": "#CBBD9D",
        "rgb": [
          203,
          189,
          157
        ],
        "$description": "Cream Body: Secondary text on Night.",
        "source": "console.css --text-body"
      },
      "cream-mute": {
        "$type": "color",
        "$value": "#9C8F70",
        "rgb": [
          156,
          143,
          112
        ],
        "$description": "Cream Mute: Captions and metadata on Night.",
