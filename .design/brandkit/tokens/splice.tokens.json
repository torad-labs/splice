          243
        ],
        "$description": "Muse provider colour. Identifies the provider; not a brand colour.",
        "source": "Splice console console.css model colours"
      },
      "router": {
        "$type": "color",
        "$value": "#F3B27A",
        "rgb": [
          243,
          178,
