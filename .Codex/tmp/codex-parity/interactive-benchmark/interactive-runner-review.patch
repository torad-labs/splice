+  if (files.length !== 1) return null;
+  const text = readFileSync(files[0]!, "utf8");
+  if (!text.endsWith("\n")) return null;
+  try {
+    return completionFromRows(client, text.split("\n").filter(Boolean).map(line => JSON.parse(line)), files);
+  } catch { return null; }
+}
