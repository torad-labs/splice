+}
+
+export function sessionFiles(home: string, client: "codex" | "claude", sessionId?: string): string[] {
+  const root = join(home, client === "codex" ? "sessions" : "projects");
+  if (!existsSync(root)) return [];
+  return readdirSync(root, { recursive: true, withFileTypes: true })
+    .filter(entry => entry.isFile() && entry.name.endsWith(".jsonl") && !entry.parentPath.split(/[\\/]/).includes("subagents") && (!sessionId || entry.name === `${sessionId}.jsonl`))
+    .map(entry => join(entry.parentPath, entry.name)).sort();
+}
+
+export function nativeCompletion(home: string, client: "codex" | "claude", sessionId?: string): InteractiveCompletion | null {
+  const files = sessionFiles(home, client, sessionId);
