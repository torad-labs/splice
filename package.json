{
  "name": "splice",
  "private": true,
  "version": "0.4.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "gate": "bun tools/gate run",
    "gate:no-python": "bun tools/gate no-python && bun test tools/gate/test/no-python.test.ts",
    "gate:rules": "bun tools/gate rules",
    "gate:audit": "bun tools/gate audit",
    "test:hooks": "bun test tools/gate/test/hook.test.ts",
    "e2e:heads": "bun tools/e2e heads",
    "e2e:heads:wire": "bun tools/e2e heads --tier 1",
    "e2e:docker": "bash tools/e2e/docker/run.sh",
    "oracle:capture": "bun tools/e2e oracle capture",
    "oracle:check": "bun tools/e2e oracle check",
    "oracle:replay": "bun tools/e2e oracle",
    "release:accept": "bun tools/release accept",
    "release:verify": "bun tools/release verify",
    "promote": "bun tools/release promote"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@playwright/test": "1.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "overrides": {
    "handlebars": "4.7.9"
  }
}
