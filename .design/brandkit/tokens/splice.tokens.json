{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Splice",
    "version": "1.0-draft",
    "date": "2026-10-19",
    "status": "Draft for Marcos's review. Not adopted by the Splice app or repo."
  },
  "color": {
    "core": {
      "night": {
        "$type": "color",
        "$value": "#1D2140",
        "rgb": [
          29,
          33,
          64
        ],
        "$description": "Night: Default background for every dark surface. About 70% of a frame.",
        "source": "console.css --wall; video frames sample #252B47"
      },
      "night-low": {
        "$type": "color",
        "$value": "#141731",
        "rgb": [
          20,
          23,
          49
        ],
        "$description": "Night Low: Second background: side navigation, footers, table headers.",
        "source": "console.css --wall-low"
      },
      "plate": {
        "$type": "color",
        "$value": "#382E25",
        "rgb": [
          56,
          46,
          37
        ],
        "$description": "Plate: Logo plate and the rail in diagrams. Large dark objects.",
        "source": "video title plate, sampled #382E25"
      },
      "shell": {
        "$type": "color",
        "$value": "#1C1610",
        "rgb": [
          28,
          22,
          16
        ],
        "$description": "Shell: Terminal screens, stat boxes, dark cards.",
        "source": "console.css --obj; video terminals sample #1C1713"
      },
      "ink": {
        "$type": "color",
        "$value": "#07050A",
        "rgb": [
          7,
          5,
          10
        ],
        "$description": "Ink: 3 px outlines and the 6 px offset shadow on every object.",
        "source": "console.css --ink (night)"
      },
      "paper": {
        "$type": "color",
        "$value": "#FBF1DF",
        "rgb": [
          251,
          241,
          223
        ],
        "$description": "Paper: Light cards, tooltips and end cards. Light-mode background.",
        "source": "video end card, sampled #FBF1DF"
      },
      "cream": {
        "$type": "color",
        "$value": "#EFE2C6",
        "rgb": [
          239,
          226,
          198
        ],
        "$description": "Cream: Body text and the wordmark on Night.",
        "source": "console.css --text (night)"
      },
      "key": {
        "$type": "color",
        "$value": "#FFD79A",
        "rgb": [
          255,
          215,
          154
