+import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+type Row = Record<string, any>;
+export interface InteractiveCompletion {
+  sessionId: string;
+  finalText: string;
+  sourceFiles: string[];
+  evidence: "codex-task-complete" | "claude-assistant-end-turn";
+}
+
+/** Native rows are evidence. No terminal text is promoted to a client event or a final answer. */
+export function completionFromRows(client: "codex" | "claude", rows: Row[], sourceFiles: string[]): InteractiveCompletion | null {
+  let sessionId: string | undefined;
+  let finalText: string | undefined;
+  let completed = false;
+  const pending = new Set<string>();
+  for (const row of rows) {
+    if (client === "codex") {
+      if (row.type === "session_meta") sessionId = row.payload?.id;
+      if (row.type !== "event_msg") continue;
+      const event = row.payload;
+      if (["task_started", "turn_aborted", "error"].includes(event?.type)) completed = false;
+      if (event?.type === "task_complete") {
+        completed = true;
+        finalText = typeof event.last_agent_message === "string" ? event.last_agent_message : "";
+      }
+      continue;
+    }
+    sessionId = typeof row.sessionId === "string" ? row.sessionId : sessionId;
+    sessionId = typeof row.session_id === "string" ? row.session_id : sessionId;
+    if (row.type === "user") {
+      completed = false;
+      if (Array.isArray(row.message?.content)) for (const part of row.message.content) {
+        if (part.type === "tool_result") pending.delete(part.tool_use_id);
+      }
+    }
+    if (row.type !== "assistant") continue;
+    const message = row.message;
+    if (!Array.isArray(message?.content)) continue;
+    for (const part of message.content) if (part.type === "tool_use" && typeof part.id === "string") pending.add(part.id);
+    completed = message.stop_reason === "end_turn" && pending.size === 0;
