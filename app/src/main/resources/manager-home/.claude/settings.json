{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(/@CONFIG_DIR@/keys.toml)",
      "Edit(/@CONFIG_DIR@/keys.toml)",
      "Read(/@CONFIG_DIR@/keys.toml.*)",
      "Edit(/@CONFIG_DIR@/keys.toml.*)",
      "Read(/@CONFIG_DIR@/key-ledger.json)",
      "Edit(/@CONFIG_DIR@/key-ledger.json)",
      "Read(/@CONFIG_DIR@/key-ledger.json.*)",
      "Edit(/@CONFIG_DIR@/key-ledger.json.*)",
      "Read(/@CONFIG_DIR@/auth/**)",
      "Edit(/@CONFIG_DIR@/auth/**)",
      "Read(~/.splice/state/**)",
      "Edit(~/.splice/state/**)",
      "Read(~/.claude-codex/state/**)",
      "Edit(~/.claude-codex/state/**)",
      "Read(/@STATE_DIR@/**)",
      "Edit(/@STATE_DIR@/**)",
      "Bash(*keys.toml*)",
      "Bash(*key-ledger*)",
      "Bash(*mgmt-key*)",
      "Bash(*console-open.html*)",
      "Bash(*.splice/state*)",
      "Bash(*.claude-codex/state*)",
      "Bash(*@STATE_DIR@*)"
    ],
    "allow": [
      "Bash(splice status)",
      "Bash(splice status *)",
      "Bash(splice logs)",
      "Bash(splice logs *)",
      "Bash(splice sessions)",
      "Bash(splice sessions *)",
      "Bash(splice doctor)",
      "Bash(splice doctor *)",
      "Bash(splice check-config)",
      "Bash(splice check-config *)",
      "Bash(splice models)",
      "Bash(splice models *)",
      "Bash(splice version)",
      "Bash(splice version *)",
      "Bash(splice console *)",
      "Read(./**)"
    ]
  }
}
